# ============ Fly 后端（Spring Boot）环境变量 ============
# 传统部署时通过 systemd EnvironmentFile 或 `set -a; source .env` 加载；
# Docker 部署请改用仓库根目录的 .env（docker-compose 读取）。

# ---- 数据库 ----
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fly
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ---- 应用 ----
# 监听端口（默认 8000）
SERVER_PORT=8000
# JWT 签名密钥：必填，至少 32 字符，缺失时启动失败
FLY_SECRET_KEY=
# CORS 允许的来源（逗号分隔）
FLY_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-domain.com

# ---- 本地音乐目录（可选；扫描失败不影响启动）----
# 不配置时代码默认指向开发机的 Windows 路径（D:\music\*），Linux 服务器建议显式设置；
# 多目录用分号分隔，指向服务器上实际存放音乐文件的目录
FLY_MUSIC_DIRS=/opt/fly/data/music/120;/opt/fly/data/music/mp3

# ---- 阿里云 OSS（可选，不配置则图片保存到本地 uploads/ 目录）----
FLY_OSS_ACCESS_KEY_ID=
FLY_OSS_ACCESS_KEY_SECRET=
FLY_OSS_BUCKET_NAME=
FLY_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
FLY_OSS_CUSTOM_DOMAIN=https://your-custom-domain.com
FLY_OSS_PREFIX=Boke/
