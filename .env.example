# ================= Fly Docker Compose 配置 =================
# 使用方法：cp .env.example .env，然后按需修改，最后 docker compose up -d --build
# 完整部署流程见 docs/运维手册.md（Rocky 9.8 / 10.x Minimal 从零安装）

# ---- 数据库 ----
POSTGRES_PASSWORD=change-me-postgres-password

# ---- 管理员初始密码（必填）----
# 仅数据库首次初始化时生效，用户名固定为 feifei；未设置时 compose 拒绝启动。
# 请设置强密码（忘记密码可在数据库重置，见 docs/运维手册.md「重置管理员密码」）。
ADMIN_INITIAL_PASSWORD=

# ---- 后端（Spring Boot）----
# JWT 签名密钥：必填，至少 32 字符，可用 `openssl rand -hex 32` 生成
FLY_SECRET_KEY=

# CORS 允许来源（逗号分隔）。【必含线上域名】浏览器发出的 POST 请求即使同源
# 也会携带 Origin 头，后端按此白名单校验，缺了会返回 403 "Invalid CORS request"
# （表现为：GET 正常、凡 POST 的功能全部报"网络错误"）。
FLY_CORS_ORIGINS=https://your-domain.com,http://localhost:3000,http://localhost:5173

# 阿里云 OSS（可选；不配置则图片保存到本地 ./fly-backend/uploads/ 目录）
FLY_OSS_ACCESS_KEY_ID=
FLY_OSS_ACCESS_KEY_SECRET=
FLY_OSS_BUCKET_NAME=
FLY_OSS_ENDPOINT=
FLY_OSS_CUSTOM_DOMAIN=
FLY_OSS_PREFIX=Boke/

# ---- 本地音乐目录（可选）----
# Linux 服务器：留空即用默认 ./data/music/120 与 ./data/music/mp3（相对 docker-compose.yml 所在目录），
#   或指向服务器真实目录，如 MUSIC_DIR_120=/data/music/120
# Windows 本机开发：指向实际磁盘目录，如 D:\music\120迈神曲
# MUSIC_DIR_120=
# MUSIC_DIR_MP3=
# 容器内扫描路径（多目录用分号分隔，一般保持默认）
FLY_MUSIC_DIRS=/music/120;/music/mp3

# ---- 前端（Next.js 构建参数）----
# SSR 首页数据抓取的后端地址，容器网络内保持默认即可
NEXT_PUBLIC_API_URL=http://backend:8000
